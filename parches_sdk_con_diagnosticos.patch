+// Parche: lector de guitarras RB4 de Xbox One por GameInput.
+// Mensaje de entrada (id 0x20), little-endian:
+//   0-1 botones (formato mando Xbox One)  2 tilt  3 whammy  4 selector de efectos
+//   5 trastes superiores  6 trastes inferiores (solo)  7-9 sin uso
+//   Riffmaster ademas: 10-11 joystick X, 12-13 joystick Y, 14 botones de sistema.
+class NativeGuitarReader {
+ public:
+  // Si hay una guitarra conectada devuelve true y deja en *pad su estado.
+  bool Poll(X_INPUT_GAMEPAD* pad) {
+    Init();
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!input_ || !device_) {
+      return false;
+    }
+    IGameInputReading* reading = nullptr;
+    if (SUCCEEDED(input_->GetCurrentReading(GameInputKindRawDeviceReport, device_, &reading)) &&
+        reading) {
+      IGameInputRawDeviceReport* report = nullptr;
+      if (reading->GetRawReport(&report) && report) {
+        uint8_t data[64] = {};
+        const uint32_t id = report->GetReportInfo()->id;
+        const size_t size = report->GetRawData(sizeof(data), data);
+        if (id == 0x20 && size >= 10) {
+          Parse(data, size);
+        }
+        report->Release();
+      }
+      reading->Release();
+    }
+    *pad = pad_;
+    return true;
+  }
+
+ private:
+  static bool IsGuitar(uint16_t vid, uint16_t pid, bool* riffmaster) {
+    *riffmaster = vid == 0x0E6F && pid == 0x0248;               // PDP Riffmaster
+    return *riffmaster || (vid == 0x0E6F && pid == 0x0170) ||  // PDP Jaguar
+           (vid == 0x0738 && pid == 0x4161);                    // Mad Catz Stratocaster
+  }
+
+  static void CALLBACK OnDevice(GameInputCallbackToken, void* context, IGameInputDevice* device,
+                                uint64_t, GameInputDeviceStatus current_status,
+                                GameInputDeviceStatus) {
+    auto* self = static_cast<NativeGuitarReader*>(context);
+    const GameInputDeviceInfo* info = device->GetDeviceInfo();
+    bool riffmaster = false;
+    if (!info || !IsGuitar(info->vendorId, info->productId, &riffmaster)) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(self->mutex_);
+    if (current_status & GameInputDeviceConnected) {
+      if (!self->device_) {
+        device->AddRef();
+        self->device_ = device;
+        self->pad_ = {};
+        REXLOG_INFO("Guitarra RB4 nativa conectada (GameInput): {:04X}:{:04X}{}", info->vendorId,
+                    info->productId, riffmaster ? " (Riffmaster)" : "");
+      }
+    } else if (self->device_ == device) {
+      self->device_->Release();
+      self->device_ = nullptr;
+      REXLOG_INFO("Guitarra RB4 nativa desconectada");
+    }
+  }
+
+  void Init() {
+    if (initialized_) {
+      return;
+    }
+    initialized_ = true;
+    HMODULE lib = LoadLibraryW(L"GameInput.dll");
+    using GameInputCreateFn = HRESULT(WINAPI*)(IGameInput**);
+    auto create =
+        lib ? reinterpret_cast<GameInputCreateFn>(GetProcAddress(lib, "GameInputCreate")) : nullptr;
+    if (!create || FAILED(create(&input_)) || !input_) {
+      REXLOG_WARN("GameInput no disponible: sin soporte nativo para guitarras RB4");
+      input_ = nullptr;
+      return;
+    }
+    // La enumeracion bloqueante llama a OnDevice con las guitarras ya conectadas;
+    // las que se conecten despues llegan desde el hilo de GameInput.
+    if (FAILED(input_->RegisterDeviceCallback(nullptr, GameInputKindRawDeviceReport,
+                                              GameInputDeviceConnected,
+                                              GameInputBlockingEnumeration, this, OnDevice,
+                                              &token_))) {
+      REXLOG_WARN("GameInput: no se pudo registrar el aviso de dispositivos");
+    }
+  }
+
+  void Parse(const uint8_t* d, size_t size) {
+    const uint16_t b = uint16_t(d[0] | (d[1] << 8));
+    const uint8_t frets = d[5] | d[6];
+    const bool lower_frets = d[6] != 0;
+    uint16_t x = 0;
+    if (b & 0x0004) x |= X_INPUT_GAMEPAD_START;       // Menu
+    if (b & 0x0008) x |= X_INPUT_GAMEPAD_BACK;        // Options (Star Power)
+    if (b & 0x0100) x |= X_INPUT_GAMEPAD_DPAD_UP;     // rasgueo arriba
+    if (b & 0x0200) x |= X_INPUT_GAMEPAD_DPAD_DOWN;   // rasgueo abajo
+    if (b & 0x0400) x |= X_INPUT_GAMEPAD_DPAD_LEFT;
+    if (b & 0x0800) x |= X_INPUT_GAMEPAD_DPAD_RIGHT;
+    if (frets & 0x01) x |= X_INPUT_GAMEPAD_A;              // verde
+    if (frets & 0x02) x |= X_INPUT_GAMEPAD_B;              // rojo
+    if (frets & 0x04) x |= X_INPUT_GAMEPAD_Y;              // amarillo
+    if (frets & 0x08) x |= X_INPUT_GAMEPAD_X;              // azul
+    if (frets & 0x10) x |= X_INPUT_GAMEPAD_LEFT_SHOULDER;  // naranja
+    // Trastes inferiores (solo) o clic del joystick de la Riffmaster.
+    if (lower_frets || (b & 0x4000)) x |= X_INPUT_GAMEPAD_LEFT_THUMB;
+    pad_.buttons = x;
+
+    // Whammy: 0..255 -> -32768..32767. Tilt: 0..255 -> 0..32767 (+ umbral de tilt).
+    pad_.thumb_rx = int16_t((d[3] << 8 | d[3]) - 0x8000);
+    int32_t tilt = (d[2] << 8 | d[2]) >> 1;
+    if (const int32_t thr = REXCVAR_GET(tilt_threshold); thr > 0 && tilt >= thr) {
+      tilt = 32767;
+    }
+    pad_.thumb_ry = int16_t(tilt);
+
+    // Selector de efectos: 5 posiciones en el gatillo izquierdo (26, 77, 128, 179, 230).
+    const int pickup = std::min(d[4] >> 4, 4) + 1;
+    pad_.left_trigger = uint8_t(51 * pickup - 25);
+    pad_.right_trigger = 0;
+
+    if (size >= 14) {  // joystick de la Riffmaster
+      pad_.thumb_lx = int16_t(d[10] | (d[11] << 8));
+      pad_.thumb_ly = int16_t(d[12] | (d[13] << 8));
+    }
+  }
+
+  IGameInput* input_ = nullptr;
+  IGameInputDevice* device_ = nullptr;
+  GameInputCallbackToken token_ = 0;
+  bool initialized_ = false;
+  std::mutex mutex_;
+  X_INPUT_GAMEPAD pad_{};
+};
