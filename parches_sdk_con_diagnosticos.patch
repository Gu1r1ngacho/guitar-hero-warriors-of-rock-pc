+static uint8_t GetNativeXInputSubType(int user_index) {
+  using XInputGetCapsFn = uint32_t (*)(uint32_t, uint32_t, void*);
+  static XInputGetCapsFn fn = []() -> XInputGetCapsFn {
+    void* lib = SDL_LoadObject("xinput1_4.dll");
+    if (!lib) lib = SDL_LoadObject("xinput1_3.dll");
+    if (!lib) return nullptr;
+    return reinterpret_cast<XInputGetCapsFn>(SDL_LoadFunction(lib, "XInputGetCapabilities"));
+  }();
+  if (!fn || user_index < 0 || user_index > 3) return 0;
+  uint8_t caps[20] = {};
+  if (fn(static_cast<uint32_t>(user_index), 0, caps) != 0) return 0;
+  return caps[1];  // SubType
+}
