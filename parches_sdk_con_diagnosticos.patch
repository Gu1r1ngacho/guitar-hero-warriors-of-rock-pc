+void TexDumpWriteBmp(const TexDumpPending& dump, const uint8_t* data) {
+  uint32_t width = dump.footprint.Footprint.Width;
+  uint32_t height = dump.footprint.Footprint.Height;
+  std::vector<uint8_t> pixels(size_t(width) * height * 4);
+  uint64_t sum[4] = {};
+  uint32_t zero_count = 0, alpha_zero_count = 0;
+  for (uint32_t y = 0; y < height; ++y) {
+    const uint8_t* row = data + size_t(dump.footprint.Footprint.RowPitch) * y;
+    for (uint32_t x = 0; x < width; ++x) {
