+  put32(10, 54);
+  put32(14, 40);
+  put32(18, width);
+  put32(22, uint32_t(-int32_t(height)));  // De arriba hacia abajo.
+  header[26] = 1;
+  header[28] = 32;
+  put32(34, image_size);
+  std::fwrite(header, 1, sizeof(header), file);
+  std::fwrite(pixels.data(), 1, pixels.size(), file);
+  std::fclose(file);
+}
+
+void TexDumpPoll(uint64_t completed_submission) {
