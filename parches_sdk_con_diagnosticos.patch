+        g = (((p >> 5) & 0x1F) * 255 + 15) / 31;
+        r = (((p >> 10) & 0x1F) * 255 + 15) / 31;
+        a = (p & 0x8000) ? 255 : 0;
+        if (!p) {
+          ++zero_count;
+        }
+      } else {
+        r = row[x * 4];
+        g = row[x * 4 + 1];
+        b = row[x * 4 + 2];
+        a = row[x * 4 + 3];
+        if (!(r | g | b | a)) {
+          ++zero_count;
+        }
+      }
+      if (!a) {
+        ++alpha_zero_count;
+      }
+      sum[0] += r;
+      sum[1] += g;
+      sum[2] += b;
+      sum[3] += a;
+      uint8_t* out = &pixels[(size_t(y) * width + x) * 4];
+      out[0] = uint8_t(b);
+      out[1] = uint8_t(g);
+      out[2] = uint8_t(r);
+      out[3] = uint8_t(a);
+    }
+  }
+  uint64_t pixel_count = std::max(uint64_t(width) * height, uint64_t(1));
+  REXGPU_WARN(
+      "TexDump: {} {}x{} promedio R={} G={} B={} A={} pixeles_cero={} alfa_cero={} de {}",
+      dump.path, width, height, sum[0] / pixel_count, sum[1] / pixel_count, sum[2] / pixel_count,
+      sum[3] / pixel_count, zero_count, alpha_zero_count, uint64_t(width) * height);
+  FILE* file = std::fopen(dump.path.c_str(), "wb");
+  if (!file) {
+    return;
+  }
+  uint32_t image_size = uint32_t(pixels.size());
+  uint8_t header[54] = {'B', 'M'};
+  auto put32 = [&header](size_t offset, uint32_t value) {
